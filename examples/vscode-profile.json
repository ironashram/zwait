{
  "// Drop these settings into ~/.config/Code/User/settings.json (Linux) or": "",
  "// ~/Library/Application Support/Code/User/settings.json (macOS).": "",
  "// bin/zvscode names one zellij session per VSCode window: vscode-<folder>": "",
  "// for a single-folder window, vscode-<workspace file basename> for a": "",
  "// multi-root .code-workspace window. It also records the window's member": "",
  "// folder(s) in /tmp/zwait_<session>_ws, which is how zsession routes the": "",
  "// helpers to the right pane - the helpers never trust VSCODE_CWD, which": "",
  "// is shared across all windows of one VSCode instance.": "",
  "// Adjust the path if you installed the helpers somewhere else; use an": "",
  "// absolute path - the profile may launch before your shell rc runs.": "",

  "terminal.integrated.profiles.linux": {
    "zellij": {
      "path": "/usr/local/bin/zvscode"
    }
  },
  "terminal.integrated.defaultProfile.linux": "zellij",
  "terminal.integrated.shellIntegration.enabled": false,
  "terminal.integrated.enablePersistentSessions": false,
  "terminal.integrated.enableMultiLinePasteWarning": "never",
  "python.terminal.shellIntegration.enabled": false
}
