# Maintainer: Michele Palazzi <sysdadmin@m1k.cloud>
pkgname=zwait
pkgver=0.2.2
pkgrel=1
pkgdesc="Drive a user's visible zellij pane from a headless agent"
arch=('any')
url="https://github.com/ironashram/zwait"
license=('MIT')
depends=('bash' 'zsh' 'zellij' 'util-linux' 'gawk' 'coreutils' 'grep' 'sed')
optdepends=('konsole: default terminal for zspawn/ztail detached windows')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 bin/zwait bin/zr bin/zi bin/zshell bin/zsession bin/zvscode bin/zspawn bin/ztail -t "$pkgdir/usr/bin"
  install -Dm644 shell/zwait.zsh -t "$pkgdir/usr/share/zwait"
  install -Dm644 examples/vscode-profile.json examples/claude-md-snippet.md examples/zellij-config.kdl -t "$pkgdir/usr/share/zwait/examples"
  install -Dm644 README.md docs/design.md -t "$pkgdir/usr/share/doc/$pkgname"
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname"
}
